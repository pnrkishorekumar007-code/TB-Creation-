# Local development: the backend runs on its own port.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production (Vercel): point this at your deployed backend origin + /api,
# e.g. NEXT_PUBLIC_API_URL=https://tb-creation-api.onrender.com/api
# Set it in the Vercel project's Environment Variables (not in this file).

# Public site URL used for OG tags / sitemap, e.g. https://your-app.vercel.app
# NEXT_PUBLIC_SITE_URL=
