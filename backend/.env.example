PORT=5000
MONGO_URI=mongodb://localhost:27017/tb-creation
# In production (Vercel) JWT_SECRET must be a real random value >= 32 chars;
# the server.js guard refuses to boot with this example value when NODE_ENV=production.
JWT_SECRET=replace_this_with_a_long_random_secret
# Optional. Signs short-lived URLs for private/draft media. Defaults to JWT_SECRET
# when unset; set a distinct value if you want to rotate media signing independently.
# MEDIA_SIGNING_SECRET=replace_with_another_long_random_secret
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Outgoing mail for password reset links. Any SMTP provider works; leave these
# unset in development and the reset link is printed to the console and returned
# in the API response instead of emailed.
# Gmail example (requires 2-Step Verification + an App Password, not your login password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your_16_char_app_password
# Brevo example: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
# MAIL_FROM is the visible sender; it must be an address your provider allows
# you to send as (defaults to SMTP_USER).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=TB Creation <no-reply@yourdomain.com>

# Where uploaded manga pages, covers, avatars and scripts are kept:
#   (unset)  local disk (backend/uploads) — fine for local development
#   db       ALSO persisted in MongoDB and restored automatically if the disk is wiped.
#            Use this on Render/Railway free tiers (ephemeral disk). On Vercel it is
#            switched on automatically because Vercel's disk is read-only.
#   disk     force plain disk storage even on Vercel
# MEDIA_STORAGE=db
