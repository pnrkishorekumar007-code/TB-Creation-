PORT=5000
MONGO_URI=mongodb://localhost:27017/tb-creation
# In production (Render/Vercel) JWT_SECRET must be a real random value >= 32 chars;
# the server refuses to boot with this example value when NODE_ENV=production.
JWT_SECRET=replace_this_with_a_long_random_secret
# Optional. Signs short-lived URLs for private/draft media. Defaults to JWT_SECRET
# when unset; set a distinct value if you want to rotate media signing independently.
# MEDIA_SIGNING_SECRET=replace_with_another_long_random_secret
# Production: the exact frontend origin (no trailing slash), e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# --- Object storage (uploads) ---
# When set, covers/pages/scripts/avatars are stored on Cloudinary instead of
# local disk. Leave unset for local development (falls back to backend/uploads).
# The Cloudinary SDK accepts either the single URL form or the three vars below.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Email (password reset) ---
# When RESEND_API_KEY is set, reset links are emailed via Resend. Otherwise the
# link is only logged in non-production.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=TB Creation <onboarding@resend.dev>
